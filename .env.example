# ─────────────────────────────────────────────────────────────
# CP-Vertex — Environment Variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
#   cp .env.example .env
# Only DATABASE_URL and AUTH_SECRET are strictly required to boot.
# Everything else degrades gracefully when unset (the related
# feature is simply disabled).
# ─────────────────────────────────────────────────────────────

# ── Database (required) ───────────────────────────────────────
# PostgreSQL connection string used by Prisma at runtime.
DATABASE_URL="postgresql://user:password@host:5432/cpvertex?sslmode=require"

# ── Auth — NextAuth v5 (required) ─────────────────────────────
# Secret used to sign sessions/JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=""
# Set to "true" when running behind a proxy / on a non-localhost host
# (e.g. Vercel) so NextAuth trusts the forwarded host header.
AUTH_TRUST_HOST="true"

# ── Auth providers (optional — credentials login works without these) ──
# Google OAuth (NextAuth auto-detects the AUTH_GOOGLE_* names).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# GitHub OAuth. Falls back to a dummy provider when unset.
GITHUB_ID=""
GITHUB_SECRET=""

# ── Redis / Queue ─────────────────────────────────────────────
# Upstash Redis (REST) — caching, rate limiting, presence.
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""
# Redis connection string for BullMQ background workers.
BULLMQ_REDIS_URL="redis://localhost:6379"

# ── Realtime — Supabase Broadcast (optional, used by duels) ───
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── AI Coach — Google Gemini (optional) ───────────────────────
GEMINI_API_KEY=""

# ── Email — Resend (optional, used by weekly digest) ──────────
RESEND_API_KEY=""
RESEND_FROM="CP-Vertex <noreply@example.com>"

# ── Cron / Admin ──────────────────────────────────────────────
# Shared secret required by /api/cron/* endpoints (sent as a Bearer token).
CRON_SECRET=""
# Comma-separated list of admin emails granted access to /admin.
ADMIN_EMAILS="you@example.com"

# ── Error tracking — Sentry (optional) ────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
